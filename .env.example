SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_DEMO_CHANNEL_ID=
OPENAI_API_KEY=
DRII_TEXT_MODEL=gpt-4.1-2025-04-14
DRII_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
DRII_EMBEDDING_MODEL=text-embedding-3-small
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
# Copy to .env locally. Never commit credentials. Node.js 24 reads root .env.
CLICKHOUSE_URL=https://your-service.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-me
CLICKHOUSE_DATABASE=drii
CLICKHOUSE_TIMEOUT_MS=10000
# Set the workspace to the real Slack team ID before seeding for Slack integration.
DRII_DEMO_WORKSPACE_ID=demo-workspace
DRII_DEMO_PROJECT_ID=launch
# Optional for transcript-only Slack intake; required for embeddings/audio.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DRII_TEXT_MODEL=gpt-4.1-2025-04-14
DRII_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
DRII_EMBEDDING_MODEL=text-embedding-3-small
DRII_MIN_RELEVANCE=0.3
# Set to 1 only when intentionally running integration tests against this service.
DRII_LIVE_TESTS=0
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me
SLACK_DEMO_CHANNEL_ID=replace-me
LOG_LEVEL=info

# Only the labeled fixture analyzer is wired to Slack so far.
DRII_ANALYSIS_MODE=fixture
