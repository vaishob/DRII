# Copy to .env locally. Never commit credentials. Node.js 24 reads root .env.
CLICKHOUSE_URL=https://your-service.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-me
CLICKHOUSE_DATABASE=drii
CLICKHOUSE_TIMEOUT_MS=10000
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
DRII_TEXT_MODEL=gpt-4.1-2025-04-14
DRII_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
DRII_EMBEDDING_MODEL=text-embedding-3-small
SLACK_BOT_TOKEN=replace-me
SLACK_APP_TOKEN=replace-me
SLACK_DEMO_CHANNEL_ID=replace-me
LOG_LEVEL=info
