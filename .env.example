# Populate locally. Do not send credentials in Slack or commit .env.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me
SLACK_DEMO_CHANNEL_ID=C_REPLACE_ME
# Optional for transcript-only mode; required when an MP3 is submitted.
OPENAI_API_KEY=
DRII_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
# Only fixture mode is wired in this first implementation.
DRII_ANALYSIS_MODE=fixture
LOG_LEVEL=info
