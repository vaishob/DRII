{
  "name": "drii",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/integration/**",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/integration",
    "lint": "eslint src tests",
    "format": "prettier --write src tests fixtures docs package.json tsconfig.json tsconfig.build.json eslint.config.js",
    "format:check": "prettier --check src tests fixtures docs package.json tsconfig.json tsconfig.build.json eslint.config.js",
    "verify": "npm run typecheck && npm test && npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "@clickhouse/client": "1.23.1",
    "openai": "7.15.0",
    "pino": "10.3.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
