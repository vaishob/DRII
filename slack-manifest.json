{
  "display_information": {
    "name": "DRII",
    "description": "Meeting intake and a clearly labeled decision-review demo",
    "background_color": "#183C45"
  },
  "features": {
    "bot_user": { "display_name": "DRII", "always_online": false }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "channels:history",
        "files:read"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "interactivity": { "is_enabled": true },
    "event_subscriptions": {
      "bot_events": ["app_mention", "message.channels"]
    },
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
